# Promoted to a real "stack" label in Loki by docker-grafana-stack's Alloy
# config - see that repo's README. Use this stack's own name so it's
# actually distinguishable from the others in Grafana.
MONITORING_STACK=hello-world

# Network Configuration
NETWORK=traefik

# Nginx Configuration
#NGINX_VER=latest
NGINX_HOST=hello.example.com
NGINX_PORT=80